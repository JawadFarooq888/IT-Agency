// Database schema. After changing it run: npx prisma migrate dev --name <change>
// Connection URLs live in prisma.config.ts / .env

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Admin ----------

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String?
  passwordHash String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  notes        LeadNote[]
}

// ---------- Leads ----------

enum LeadStatus {
  NEW
  CONTACTED
  PROPOSAL_SENT
  WON
  LOST
}

model Lead {
  id             String     @id @default(cuid())
  fullName       String
  email          String
  phone          String?
  company        String?
  service        String
  budget         String?
  timeline       String?
  details        String
  attachmentUrl  String?
  attachmentName String?
  status         LeadStatus @default(NEW)

  // Where the lead came from
  sourcePage  String?
  referrer    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?
  ipHash      String?
  userAgent   String?

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  notes     LeadNote[]

  @@index([status])
  @@index([service])
  @@index([createdAt])
}

model LeadNote {
  id        String   @id @default(cuid())
  body      String
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([leadId])
}

/// One row per request, used for per-IP rate limiting of public endpoints
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// ---------- Content ----------

model PortfolioItem {
  id               String   @id @default(cuid())
  slug             String   @unique
  title            String
  client           String
  industry         String
  country          String
  category         String // web | mobile | ai | other
  services         String[] // service slugs from src/content/services.ts
  summary          String
  problem          String
  solution         String
  result           String // one-line result shown on cards
  results          String[]
  tech             String[]
  coverImage       String?
  gallery          String[]
  testimonialQuote String?
  testimonialName  String?
  testimonialRole  String?
  published        Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([published, sortOrder])
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String
  company   String
  country   String
  quote     String
  published Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, sortOrder])
}

/// People shown on the About page. The first "featured" member gets the big founder section.
model TeamMember {
  id        String   @id @default(cuid())
  name      String
  role      String // job title, e.g. "Founder & CEO"
  photo     String? // Vercel Blob URL or a path in /public
  email     String?
  phone     String?
  bio       String? // paragraphs separated by a blank line
  featured  Boolean  @default(false)
  published Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, sortOrder])
}

model Category {
  id    String     @id @default(cuid())
  name  String
  slug  String     @unique
  posts BlogPost[]
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

model BlogPost {
  id             String     @id @default(cuid())
  slug           String     @unique
  title          String
  excerpt        String
  content        String // Markdown
  coverImage     String?
  authorName     String
  categoryId     String?
  category       Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  seoTitle       String?
  seoDescription String?
  status         PostStatus @default(DRAFT)
  publishedAt    DateTime?
  sortOrder      Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([status, publishedAt])
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  published Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, sortOrder])
}

/// Key/value store for settings editable in /admin/settings
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
