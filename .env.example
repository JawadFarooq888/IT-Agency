# Copy this file to .env and fill in the values.
# Variables starting with NEXT_PUBLIC_ are sent to the browser. Never put secrets in them.

# ---------- Site ----------
# Full public URL of the site, no trailing slash. Used for canonical URLs, sitemap and emails.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------- Database (Neon or Supabase PostgreSQL) ----------
# Pooled connection string used by the app at runtime (Neon: the "-pooler" host).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
# Direct (non-pooled) connection string used by Prisma migrations. Optional if you only have one URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

# ---------- Admin login (Auth.js / NextAuth v5) ----------
# Random secret used to sign login sessions. Generate one with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET=""
# Same value is accepted under the older name, for tools that expect it.
# NEXTAUTH_SECRET=""
# Set to true when running behind a proxy other than Vercel (Vercel sets this automatically).
# AUTH_TRUST_HOST=true

# Admin user created by the seed script (npm run db:seed). Change the password after first login.
ADMIN_SEED_EMAIL="admin@yourbrand.com"
ADMIN_SEED_PASSWORD="change-me-to-a-long-password"
ADMIN_SEED_NAME="Admin"

# ---------- Email (Resend) ----------
# API key from https://resend.com/api-keys
RESEND_API_KEY=""
# Sender address on your verified domain, e.g. "YourBrand <hello@yourbrand.com>"
EMAIL_FROM="YourBrand <hello@yourbrand.com>"
# Where new lead notifications are sent (your inbox)
ADMIN_EMAIL="you@yourbrand.com"

# ---------- Spam protection (Cloudflare Turnstile) ----------
# From https://dash.cloudflare.com/?to=/:account/turnstile . Leave both empty to disable in development.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ---------- File uploads (Vercel Blob) ----------
# Created automatically when you add a Blob store in Vercel > Storage. Copy it here for local development.
BLOB_READ_WRITE_TOKEN=""

# ---------- Analytics ----------
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Leave empty to disable tracking.
NEXT_PUBLIC_GA_ID=""
# Google Search Console HTML tag verification code (only the content="..." value).
NEXT_PUBLIC_GSC_VERIFICATION=""

# ---------- Contact defaults ----------
# Used until you save contact details in /admin/settings.
# WhatsApp number in international format, digits only (no + or spaces), e.g. 923001234567
NEXT_PUBLIC_WHATSAPP_NUMBER="923000000000"
NEXT_PUBLIC_CONTACT_EMAIL="hello@yourbrand.com"
NEXT_PUBLIC_CALENDLY_URL="https://calendly.com/yourbrand/20min"
